<?xml version="1.0"?>
<!-- Gegenereerd uit Agrobot_assem.STEP (SolidWorks 2025). Frames volgens REP-103: x vooruit, y links, z omhoog. -->
<!-- Massa's zijn schattingen (aluminium 2700 kg/m3, accu 2000 kg/m3, wiel 8 kg). Pas aan naar gewogen waarden. -->
<robot name="agrobot_atd">
  <material name="aluminium"><color rgba="0.75 0.77 0.80 1"/></material>
  <material name="dark_grey"><color rgba="0.25 0.27 0.30 1"/></material>
  <material name="battery_blue"><color rgba="0.15 0.35 0.65 1"/></material>
  <material name="rubber"><color rgba="0.08 0.08 0.08 1"/></material>

  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.2032" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual name="chassis_frame">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://agrobot_description/meshes/chassis_frame.stl"/></geometry>
      <material name="aluminium"/>
    </visual>
    <visual name="battery">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://agrobot_description/meshes/battery.stl"/></geometry>
      <material name="battery_blue"/>
    </visual>
    <visual name="wheel_housing">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://agrobot_description/meshes/wheel_housing.stl"/></geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="-3.3307e-15 0.0005 0.369" rpy="0 0 0"/>
      <geometry><box size="1.0905 1.697 0.134"/></geometry>
    </collision>
    <collision>
      <origin xyz="0.39817 0.75825 0.21014" rpy="0 0 0"/>
      <geometry><box size="0.36784 0.2845 0.46172"/></geometry>
    </collision>
    <collision>
      <origin xyz="0.39618 -0.75825 0.21014" rpy="0 0 0"/>
      <geometry><box size="0.36785 0.2845 0.46172"/></geometry>
    </collision>
    <collision>
      <origin xyz="-0.39168 0.75825 0.21014" rpy="0 0 0"/>
      <geometry><box size="0.38084 0.2845 0.46172"/></geometry>
    </collision>
    <collision>
      <origin xyz="-0.38968 -0.75825 0.21014" rpy="0 0 0"/>
      <geometry><box size="0.38083 0.2845 0.46172"/></geometry>
    </collision>
    <inertial>
      <origin xyz="-0.0009285 -0.003204 0.27675" rpy="0 0 0"/>
      <mass value="83.045"/>
      <inertia ixx="47.581" ixy="-0.0077943" ixz="0.0063626" iyy="13.474" iyz="0.02521" izz="59.747"/>
    </inertial>
  </link>

  <link name="rear_left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://agrobot_description/meshes/wheel_rear_left.stl"/></geometry>
      <material name="rubber"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.2032" length="0.0771"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="8.0"/>
      <inertia ixx="0.086541" ixy="0" ixz="0" iyy="0.16516" iyz="0" izz="0.086541"/>
    </inertial>
  </link>
  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_left_wheel"/>
    <origin xyz="-0.40525 0.776 -2.1094e-15" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="40" velocity="20"/>
    <dynamics damping="0.1" friction="0.0"/>
  </joint>

  <link name="front_left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://agrobot_description/meshes/wheel_front_left.stl"/></geometry>
      <material name="rubber"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.2032" length="0.0771"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="8.0"/>
      <inertia ixx="0.086541" ixy="0" ixz="0" iyy="0.16516" iyz="0" izz="0.086541"/>
    </inertial>
  </link>
  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="front_left_wheel"/>
    <origin xyz="0.40525 0.776 -1.9984e-15" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="40" velocity="20"/>
    <dynamics damping="0.1" friction="0.0"/>
  </joint>

  <link name="front_right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://agrobot_description/meshes/wheel_front_right.stl"/></geometry>
      <material name="rubber"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.2032" length="0.0771"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="8.0"/>
      <inertia ixx="0.086541" ixy="0" ixz="0" iyy="0.16516" iyz="0" izz="0.086541"/>
    </inertial>
  </link>
  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="front_right_wheel"/>
    <origin xyz="0.40325 -0.776 2.1649e-15" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="40" velocity="20"/>
    <dynamics damping="0.1" friction="0.0"/>
  </joint>

  <link name="rear_right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://agrobot_description/meshes/wheel_rear_right.stl"/></geometry>
      <material name="rubber"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.2032" length="0.0771"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="8.0"/>
      <inertia ixx="0.086541" ixy="0" ixz="0" iyy="0.16516" iyz="0" izz="0.086541"/>
    </inertial>
  </link>
  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_right_wheel"/>
    <origin xyz="-0.40325 -0.776 2.1094e-15" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="40" velocity="20"/>
    <dynamics damping="0.1" friction="0.0"/>
  </joint>

</robot>
