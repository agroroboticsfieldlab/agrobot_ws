<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- One wheel = one ODrive, same ODrive configuration and gear ratio as the Curio -->
  <xacro:macro name="agrobot_atd_wheel" params="joint node_id use_mock_hardware">
    <joint name="${joint}">
      <param name="node_id">${node_id}</param>
      <param name="gear_ratio">50</param> <!-- 10 pole pairs x 5:1 planetary; ODrive set to 1 pole pair -->
      <!-- The ODrive plugin exports its own interfaces; mock hardware needs them listed here -->
      <xacro:if value="${use_mock_hardware}">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </xacro:if>
    </joint>
  </xacro:macro>

  <xacro:macro name="agrobot_atd_ros2_control" params="name prefix use_mock_hardware">

    <ros2_control name="${name}" type="system">
      <xacro:unless value="${use_mock_hardware}">
        <hardware>
          <plugin>agrobot_odrive/GearedODriveHardwareInterface</plugin> <!-- original ODrive plugin + gear_ratio, see agrobot_odrive -->
          <param name="can">can0</param>
        </hardware>
      </xacro:unless>
      <xacro:if value="${use_mock_hardware}">
        <hardware>
          <plugin>mock_components/GenericSystem</plugin>
          <param name="calculate_dynamics">true</param>
        </hardware>
      </xacro:if>
      <!-- CAN node IDs (ODrive config files: agrobot_odrive/config/odrive/odrive_motor{A,B,C,D}.json)
           1 = motor A = rear right, 2 = motor B = rear left, 3 = motor C = front left, 4 = motor D = front right -->
      <xacro:agrobot_atd_wheel joint="${prefix}rear_right_wheel_joint"  node_id="1" use_mock_hardware="${use_mock_hardware}"/>
      <xacro:agrobot_atd_wheel joint="${prefix}rear_left_wheel_joint"   node_id="2" use_mock_hardware="${use_mock_hardware}"/>
      <xacro:agrobot_atd_wheel joint="${prefix}front_left_wheel_joint"  node_id="3" use_mock_hardware="${use_mock_hardware}"/>
      <xacro:agrobot_atd_wheel joint="${prefix}front_right_wheel_joint" node_id="4" use_mock_hardware="${use_mock_hardware}"/>
    </ros2_control>

  </xacro:macro>

</robot>
