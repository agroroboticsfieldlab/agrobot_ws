<?xml version="1.0"?>
<!-- Agrobot ATD: 4-wheel skid steering base, every wheel driven by its own ODrive -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="agrobot_atd">
  <xacro:arg name="prefix" default="" />
  <xacro:arg name="use_mock_hardware" default="false" />

  <!-- Links, joints, meshes and materials, generated from the CAD model (plain URDF, no prefix support) -->
  <xacro:include filename="$(find agrobot_description)/urdf/agrobot_atd.urdf" />

  <!-- Import agrobot_atd ros2_control description -->
  <xacro:include filename="$(find agrobot_description)/urdf/agrobot_atd.ros2_control.xacro" />

  <xacro:agrobot_atd_ros2_control
    name="agrobot_atd_hardware" prefix="$(arg prefix)" use_mock_hardware="$(arg use_mock_hardware)"/>

</robot>
