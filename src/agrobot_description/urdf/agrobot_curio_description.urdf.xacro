<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="agrobot_curio" params="prefix">

  <!-- Constants for robot dimensions -->
  <xacro:property name="PI" value="3.1415926535897931"/>
  <xacro:property name="base_mass" value="0.3" /> <!-- arbitrary value for base mass -->
  <xacro:property name="base_width" value="1.49" /> <!-- chassis size along y (left-right) -->
  <xacro:property name="base_length" value="1.49" /> <!-- chassis size along x (front-back) -->
  <xacro:property name="base_height" value="0.05" />
  <xacro:property name="chassis_ground_clearance" value="0.62" /> <!-- bottom of chassis above the ground -->
  <xacro:property name="chassis_clearance" value="${chassis_ground_clearance - wheel_radius}" /> <!-- bottom of chassis above wheel axle center -->
  <xacro:property name="wheel_mass" value="0.3" /> <!-- arbitrary value for wheel mass -->
  <xacro:property name="wheel_len" value="0.0814" />
  <xacro:property name="wheel_radius" value="0.1257" />
  <xacro:property name="track_width" value="1.335" /> <!-- distance between wheel centers -->
  <xacro:property name="max_wheel_velocity" value="${1.0 / wheel_radius}" /> <!-- [rad/s], 1.0 m/s at the wheel, matches linear.x.max_velocity -->
  <xacro:property name="caster_wheel_mass" value="0.1" /> <!-- arbitrary value for caster wheel mass -->
  <xacro:property name="caster_wheel_radius" value="0.13" /> <!-- 4.10/3.50-4 tire, approx. 260 mm diameter -->
  <xacro:property name="caster_wheel_len" value="0.085" /> <!-- 4.10/3.50-4 tire, approx. 85 mm wide -->
  <xacro:property name="caster_track_width" value="1.445" /> <!-- distance between caster wheel centers (base_width - 2 * caster_swivel_inset) -->
  <!-- Drive axle sits under the front edge of the chassis; base_link stays on the axle center
       (diff_drive rotation center), so the chassis is shifted backwards. -->
  <xacro:property name="chassis_offset_x" value="${-base_length/2}" />
  <!-- Caster swivel axes sit under the rear corners of the chassis, caster_swivel_inset from the rear and side edges;
       the wheels trail caster_trail behind the swivel axis (driving forward) -->
  <xacro:property name="caster_swivel_inset" value="0.0225" />
  <xacro:property name="caster_trail" value="0.05" /> <!-- horizontal offset of wheel axle from swivel axis -->
  <xacro:property name="caster_swivel_x" value="${chassis_offset_x - base_length/2 + caster_swivel_inset}" />

  <!-- Base Footprint (root link without inertia, required by KDL) -->
  <link name="${prefix}base_footprint"/>

  <joint name="${prefix}base_footprint_joint" type="fixed">
    <parent link="${prefix}base_footprint"/>
    <child link="${prefix}base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- Base Link -->
  <link name="${prefix}base_link">
    <collision>
      <origin xyz="${chassis_offset_x} 0 ${chassis_clearance + base_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>

    <visual>
      <origin xyz="${chassis_offset_x} 0 ${chassis_clearance + base_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="orange"/>
    </visual>

    <inertial>
      <origin xyz="${chassis_offset_x} 0 ${chassis_clearance + base_height/2}" rpy="0 0 0"/>
      <mass value="${base_mass}"/>
      <inertia
        ixx="${base_mass / 12.0 * (base_width*base_width + base_height*base_height)}" ixy="0.0" ixz="0.0"
        iyy="${base_mass / 12.0 * (base_height*base_height + base_length*base_length)}" iyz="0.0"
        izz="${base_mass / 12.0 * (base_length*base_length + base_width*base_width)}"/>
      </inertial>
    </link>

    <joint name="${prefix}left_wheel_joint" type="continuous">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}left_wheel"/>
      <origin xyz="0 ${track_width/2} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.2"/>
      <limit effort="100" velocity="${max_wheel_velocity}"/>
    </joint>

    <!-- left wheel Link -->
    <link name="${prefix}left_wheel">
      <collision>
        <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
        <geometry>
          <cylinder length="${wheel_len}" radius="${wheel_radius}"/>
        </geometry>
      </collision>

      <visual>
        <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
        <geometry>
          <cylinder length="${wheel_len}" radius="${wheel_radius}"/>
        </geometry>
        <material name="black"/>
      </visual>

      <inertial>
        <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
        <mass value="${wheel_mass}"/>
        <inertia
          ixx="${wheel_mass / 12.0 * (3*wheel_radius*wheel_radius + wheel_len*wheel_len)}" ixy="0.0" ixz="0.0"
          iyy="${wheel_mass / 12.0 * (3*wheel_radius*wheel_radius + wheel_len*wheel_len)}" iyz="0.0"
          izz="${wheel_mass / 2.0 * wheel_radius*wheel_radius}"/>
        </inertial>
      </link>

    <joint name="${prefix}right_wheel_joint" type="continuous">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}right_wheel"/>
      <origin xyz="0 -${track_width/2} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.2"/>
      <limit effort="100" velocity="${max_wheel_velocity}"/>
    </joint>

    <!-- right wheel Link -->
    <link name="${prefix}right_wheel">
      <collision>
        <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
        <geometry>
          <cylinder length="${wheel_len}" radius="${wheel_radius}"/>
        </geometry>
      </collision>

      <visual>
        <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
        <geometry>
          <cylinder length="${wheel_len}" radius="${wheel_radius}"/>
        </geometry>
        <material name="black"/>
      </visual>

      <inertial>
        <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
        <mass value="${wheel_mass}"/>
        <inertia
          ixx="${wheel_mass / 12.0 * (3*wheel_radius*wheel_radius + wheel_len*wheel_len)}" ixy="0.0" ixz="0.0"
          iyy="${wheel_mass / 12.0 * (3*wheel_radius*wheel_radius + wheel_len*wheel_len)}" iyz="0.0"
          izz="${wheel_mass / 2.0 * wheel_radius*wheel_radius}"/>
        </inertial>
      </link>

    <joint name="${prefix}caster_rear_left_wheel_joint" type="fixed">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}caster_rear_left_wheel"/>
      <origin xyz="${caster_swivel_x - caster_trail} ${caster_track_width/2} ${-wheel_radius + caster_wheel_radius}" rpy="0 0 0"/>
    </joint>

    <!-- caster rear left wheel Link -->
    <link name="${prefix}caster_rear_left_wheel">
      <collision>
        <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
        <geometry>
          <cylinder length="${caster_wheel_len}" radius="${caster_wheel_radius}"/>
        </geometry>
      </collision>

      <visual>
        <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
        <geometry>
          <cylinder length="${caster_wheel_len}" radius="${caster_wheel_radius}"/>
        </geometry>
        <material name="white"/>
      </visual>

      <inertial>
        <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
        <mass value="${caster_wheel_mass}"/>
        <inertia
          ixx="${caster_wheel_mass / 12.0 * (3*caster_wheel_radius*caster_wheel_radius + caster_wheel_len*caster_wheel_len)}" ixy="0.0" ixz="0.0"
          iyy="${caster_wheel_mass / 12.0 * (3*caster_wheel_radius*caster_wheel_radius + caster_wheel_len*caster_wheel_len)}" iyz="0.0"
          izz="${caster_wheel_mass / 2.0 * caster_wheel_radius*caster_wheel_radius}"/>
        </inertial>
      </link>

    <joint name="${prefix}caster_rear_right_wheel_joint" type="fixed">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}caster_rear_right_wheel"/>
      <origin xyz="${caster_swivel_x - caster_trail} -${caster_track_width/2} ${-wheel_radius + caster_wheel_radius}" rpy="0 0 0"/>
    </joint>

    <!-- caster rear right wheel Link -->
    <link name="${prefix}caster_rear_right_wheel">
      <collision>
        <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
        <geometry>
          <cylinder length="${caster_wheel_len}" radius="${caster_wheel_radius}"/>
        </geometry>
      </collision>

      <visual>
        <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
        <geometry>
          <cylinder length="${caster_wheel_len}" radius="${caster_wheel_radius}"/>
        </geometry>
        <material name="white"/>
      </visual>

      <inertial>
        <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
        <mass value="${caster_wheel_mass}"/>
        <inertia
          ixx="${caster_wheel_mass / 12.0 * (3*caster_wheel_radius*caster_wheel_radius + caster_wheel_len*caster_wheel_len)}" ixy="0.0" ixz="0.0"
          iyy="${caster_wheel_mass / 12.0 * (3*caster_wheel_radius*caster_wheel_radius + caster_wheel_len*caster_wheel_len)}" iyz="0.0"
          izz="${caster_wheel_mass / 2.0 * caster_wheel_radius*caster_wheel_radius}"/>
        </inertial>
      </link>

  </xacro:macro>

</robot>