<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="agrobot_curio_ros2_control" params="name prefix use_mock_hardware">

    <ros2_control name="${name}" type="system">
      <xacro:unless value="${use_mock_hardware}">
        <hardware>
          <plugin>agrobot_odrive/GearedODriveHardwareInterface</plugin> <!-- original ODrive plugin + gear_ratio, see agrobot_odrive -->
          <param name="can">can0</param>
        </hardware>
      </xacro:unless>
      <xacro:if value="${use_mock_hardware}">
        <hardware>
          <plugin>mock_components/GenericSystem</plugin>
          <param name="calculate_dynamics">true</param>
        </hardware>
      </xacro:if>
      <!-- CAN node IDs: 1 = motor A = front right, 2 = motor B = front left -->
      <joint name="${prefix}left_wheel_joint">
        <param name="node_id">2</param>
        <param name="gear_ratio">50</param> <!-- 10 pole pairs x 5:1 planetary; ODrive set to 1 pole pair -->
        <!-- The ODrive plugin exports its own interfaces; mock hardware needs them listed here -->
        <xacro:if value="${use_mock_hardware}">
          <command_interface name="velocity"/>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
        </xacro:if>
      </joint>
      <joint name="${prefix}right_wheel_joint">
        <param name="node_id">1</param>
        <param name="gear_ratio">50</param> <!-- 10 pole pairs x 5:1 planetary; ODrive set to 1 pole pair -->
        <!-- The ODrive plugin exports its own interfaces; mock hardware needs them listed here -->
        <xacro:if value="${use_mock_hardware}">
          <command_interface name="velocity"/>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
        </xacro:if>
      </joint>
    </ros2_control>

  </xacro:macro>

</robot>