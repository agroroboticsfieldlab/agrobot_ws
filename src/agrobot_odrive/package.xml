<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>agrobot_odrive</name>
  <version>0.0.0</version>
  <description>
    Agrobot additions to ros_odrive: a ros2_control plugin that adds a gear ratio on top of the
    unmodified odrive_ros2_control plugin, the ODrive configuration files and the ODrive documentation.
  </description>
  <maintainer email="agrobot@todo.todo">agrobot</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>

  <exec_depend>odrive_ros2_control</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
